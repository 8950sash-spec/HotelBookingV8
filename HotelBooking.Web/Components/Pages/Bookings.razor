@page "/bookings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using HotelBooking.Core.Models
@using HotelBooking.Core.Services
@inject IBookingService BookingService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Мои бронирования</PageTitle>

<h3>@(isAdmin ? "Все бронирования" : "Мои бронирования")</h3>

@if (bookings == null)
{
    <p>Загрузка...</p>
}
else if (!bookings.Any())
{
    <p>Бронирований пока нет.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>№</th>
                <th>Гость</th>
                <th>Номер</th>
                <th>Заезд</th>
                <th>Выезд</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in bookings)
            {
                <tr>
                    <td>@booking.Id</td>
                    <td>@booking.Guest?.FirstName @booking.Guest?.LastName</td>
                    <td>@booking.Room?.Number</td>
                    <td>@booking.CheckInDate.ToShortDateString()</td>
                    <td>@booking.CheckOutDate.ToShortDateString()</td>
                    <td>@booking.TotalPrice.ToString("C")</td>
                    <td>
                        @switch (booking.Status)
                        {
                            case BookingStatus.Confirmed:
                                <span class="badge bg-success">Подтверждено</span>
                                break;
                            case BookingStatus.Cancelled:
                                <span class="badge bg-danger">Отменено</span>
                                break;
                            case BookingStatus.Completed:
                                <span class="badge bg-secondary">Завершено</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (booking.Status == BookingStatus.Confirmed)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => CancelBooking(booking.Id)">Отменить</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Booking>? bookings;
    private bool isAdmin;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isAdmin = user.IsInRole("Admin");
        
        if (isAdmin)
        {
            bookings = await BookingService.GetAllAsync();
        }
        else
        {
            bookings = await BookingService.GetByUserIdAsync(currentUserId!);
        }
    }

    private async Task CancelBooking(int id)
    {
        await BookingService.CancelAsync(id);
        // Перезагружаем список
        if (isAdmin)
            bookings = await BookingService.GetAllAsync();
        else
            bookings = await BookingService.GetByUserIdAsync(currentUserId!);
    }
}